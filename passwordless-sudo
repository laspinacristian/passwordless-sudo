#!/bin/bash
# Temporary, per-user passwordless sudo window. Installed file must be owned by root.
set -euo pipefail
export PATH=/usr/sbin:/usr/bin:/sbin:/bin

readonly BIN=/usr/local/bin/passwordless-sudo
readonly RUNTIME=/run/passwordless-sudo
readonly USAGE='Usage: passwordless-sudo [1..100 | status | off]'

die() { echo "Error: $*" >&2; exit 1; }

is_admin() {
    local group
    for group in $(id -nG "$1"); do
        [[ $group == sudo || $group == wheel ]] && return 0  # Debian/Ubuntu, Fedora
    done
    return 1
}

# sudo-rs rejects NOTBEFORE/NOTAFTER: there the systemd timer alone ends the window.
policy() {
    local uid=$1 start=$2 end=$3 dated=''
    if [[ $(sudo -V | head -n1) != sudo-rs* ]]; then
        dated="NOTBEFORE=$(date -u -d "@$start" +%Y%m%d%H%M%SZ) NOTAFTER=$(date -u -d "@$end" +%Y%m%d%H%M%SZ) "
    fi
    # The dated rule follows a password-required fallback. The helper itself
    # always requires authentication, including during an existing window.
    printf '%s\n' \
        "Defaults:#$uid timestamp_timeout=0" \
        "#$uid ALL=(ALL:ALL) PASSWD: ALL" \
        "#$uid ALL=(ALL:ALL) ${dated}NOPASSWD: ALL" \
        "#$uid ALL=(root) PASSWD: $BIN"
}

lock() {
    install -d -m 0755 "$RUNTIME"
    exec 9>/run/passwordless-sudo.lock
    flock -x 9
}

clear_window() {
    # Invalidate all cached sudo authentications before restoring usual policy.
    # If that fails the existing rule stays: it still expires on its own.
    runuser -u "$(id -nu "$1")" -- sudo -K \
        && rm -f -- "$RUNTIME/user-$1" "$RUNTIME/user-$1.state"
}

activate() {
    local uid=$1 minutes=$2 start end token
    start=$(date +%s)
    end=$((start + minutes * 60))
    token=$(od -An -N12 -tx1 /dev/urandom | tr -d ' \n')
    # sudo ignores file names containing a dot, so pending files are never read.
    pending=$(mktemp "$RUNTIME/.pending-XXXXXX")
    trap 'rm -f -- "$pending"' EXIT
    policy "$uid" "$start" "$end" > "$pending"
    chmod 0440 "$pending"
    visudo -cf "$pending" >/dev/null
    # Schedule BEFORE granting access. A failed timer leaves existing policy intact.
    # A wall-clock timer also fires on resume if the deadline passed during suspend.
    systemd-run --quiet --collect --unit="passwordless-sudo-$uid-$token" \
        --on-calendar="$(date -u -d "@$end" '+%Y-%m-%d %H:%M:%S UTC')" \
        --timer-property=AccuracySec=1s --timer-property=RandomizedDelaySec=0 \
        "$BIN" --expire "$uid" "$token"
    if ! { clear_window "$uid" \
            && echo "$end $token" > "$RUNTIME/user-$uid.state" \
            && mv -f -- "$pending" "$RUNTIME/user-$uid" \
            && visudo -c >/dev/null; }; then
        rm -f -- "$RUNTIME/user-$uid" "$RUNTIME/user-$uid.state"
        die 'activation failed, window revoked.'
    fi
    echo "Passwordless sudo enabled for $minutes minute$( ((minutes == 1)) || echo s), until $(date -d "@$end" '+%H:%M:%S %Z')."
}

status() {
    local end=0 token remaining
    [[ -f "$RUNTIME/user-$1.state" ]] && read -r end token < "$RUNTIME/user-$1.state"
    remaining=$((end - $(date +%s)))
    if (( remaining > 0 )) && [[ -f "$RUNTIME/user-$1" ]]; then
        echo "Active: $((remaining / 60)) min $((remaining % 60)) s remaining."
    else
        echo 'Inactive.'
    fi
}

expire() {
    (( EUID == 0 && $# == 2 )) && [[ $1 =~ ^[0-9]+$ ]] \
        || die 'internal operation reserved for the system timer.'
    local end token
    lock
    [[ -f "$RUNTIME/user-$1.state" ]] || return 0
    read -r end token < "$RUNTIME/user-$1.state"
    # A timer from a replaced window must not revoke the new one.
    if [[ $token == "$2" ]]; then clear_window "$1"; fi
}

main() {
    case "${1:-}" in
        -h|--help) echo "$USAGE"; echo 'Default: 15 minutes. Every activation asks for your password.'; return ;;
        --expire) shift; expire "$@"; return ;;
    esac
    (( $# <= 1 )) || die "$USAGE"
    local action=${1:-15} uid
    if [[ $action != off && $action != status ]]; then
        [[ $action =~ ^[0-9]{1,3}$ ]] && (( 10#$action >= 1 && 10#$action <= 100 )) \
            || die 'duration must be a whole number of minutes from 1 to 100.'
        action=$((10#$action))
    fi
    if (( EUID == 0 )); then uid=${SUDO_UID:-0}; else uid=$(id -u); fi
    [[ $uid =~ ^[0-9]+$ ]] && (( uid > 0 )) || die 'run this as your normal user, not from a root shell.'
    if [[ $action == status ]]; then status "$uid"; return; fi
    (( EUID == 0 )) || exec sudo -k -- "$BIN" "$action"
    is_admin "$(id -nu "$uid")" || die 'only members of the sudo or wheel group can use this.'
    lock
    if [[ $action == off ]]; then
        clear_window "$uid"
        echo 'Disabled. Sudo credential cache cleared.'
    else
        activate "$uid" "$action"
    fi
}

main "$@"
